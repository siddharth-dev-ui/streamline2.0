# Optional remote provider settings (not required).
# Streamline uses the built-in local StreamlineLLM by default.

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.arliai.com/v1
# OPENAI_MODEL=

# Auth — email/password works with no secrets.
# For Google / Discord, copy .streamlit/secrets.toml.example → secrets.toml
# APP_BASE_URL=http://localhost:8501
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
