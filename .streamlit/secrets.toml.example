# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud → Settings → Secrets.
#
# Email/password works with no secrets.
# Google and Discord need OAuth apps + APP_BASE_URL matching your deployed URL.

APP_BASE_URL = "http://localhost:8501"
# Streamlit Cloud example:
# APP_BASE_URL = "https://YOUR-APP.streamlit.app"

AUTH_COOKIE_SECRET = "replace-with-a-long-random-string"

[google]
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"

[discord]
client_id = "YOUR_DISCORD_CLIENT_ID"
client_secret = "YOUR_DISCORD_CLIENT_SECRET"
